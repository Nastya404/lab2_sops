@model CrittersApp.Models.Roster
@{
    ViewData["Title"] = "Добавить игрока";
}

<h2>Новая запись Roster</h2>

<div class="alert alert-info">
    <strong>Условия, которым должна соответствовать запись:</strong>
    <ol class="mb-0">
        <li>Если позиция — вратарь (<b>G</b>), то рост должен быть не менее 180 см, а вес — не менее 80 кг.</li>
        <li>Если позиция — центральный нападающий (<b>C</b>) и игрок родился до 2000 года, то номер должен быть меньше
            15.</li>
            <li>Если игрок родился в штате <b>MA</b> и его рост больше 185 см, то вес должен быть не менее 90 кг.</li>
            <li>Если игроку меньше 25 лет и он играет на позиции защитника (<b>D</b>), и его рост меньше 185 см, то вес не
                должен превышать 85 кг.</li>
            </ol>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post">
            <div class="mb-2">
                <label>ID игрока</label>
                <input asp-for="PlayerId" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Номер (jersey)</label>
                <input asp-for="Jersey" type="number" min="1" max="99" class="form-control" />
                <span asp-validation-for="Jersey" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label>Имя</label>
                <input asp-for="FName" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Фамилия</label>
                <input asp-for="SName" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Позиция</label>
                <select asp-for="Position" class="form-control" asp-items="@(new SelectList(ViewBag.Positions))"></select>
            </div>
            <div class="mb-2">
                <label>Дата рождения</label>
                <input asp-for="Birthday" type="date" min="1980-01-01" max="2016-12-31" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Вес (кг)</label>
                <input asp-for="Weight" type="number" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Рост (см)</label>
                <input asp-for="Height" type="number" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Город рождения</label>
                <input asp-for="BirthCity" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Штат рождения</label>
                <select asp-for="BirthState" class="form-control" asp-items="@(new SelectList(ViewBag.States))"></select>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
        </form>