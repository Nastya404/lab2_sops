@model CrittersApp.Models.Player
@{
    ViewData["Title"] = "Добавить игрока";
}

<h2>Новая запись Roster</h2>

<div class="alert alert-info">
    <strong>Условия, которым должна соответствовать запись:</strong>
    <ol class="mb-0">
        <li>Если позиция — вратарь (<b>G</b>), то рост должен быть не менее 180 см, а вес — не менее 80 кг.</li>
        <li>Если позиция — центральный нападающий (<b>C</b>) и игрок родился до 2000 года, то номер должен быть меньше 15.</li>
        <li>Если игрок родился в штате <b>MA</b> и его рост больше 185 см, то вес должен быть не менее 90 кг.</li>
        <li>Если игроку меньше 25 лет и он играет на позиции защитника (<b>D</b>), и его рост меньше 185 см, то вес не должен превышать 85 кг.</li>
    </ol>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="Create" method="post">
    <div class="mb-2">
        <label asp-for="PlayerId" class="form-label"></label>
        <input asp-for="PlayerId" class="form-control" />
        <span asp-validation-for="PlayerId" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Jersey" class="form-label"></label>
        <input asp-for="Jersey" type="number" min="1" max="99" class="form-control" />
        <span asp-validation-for="Jersey" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="FName" class="form-label"></label>
        <input asp-for="FName" class="form-control" />
        <span asp-validation-for="FName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="SName" class="form-label"></label>
        <input asp-for="SName" class="form-control" />
        <span asp-validation-for="SName" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Position" class="form-label"></label>
        <select asp-for="Position" class="form-select" asp-items="ViewBag.Positions"></select>
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Birthday" class="form-label"></label>
        <input asp-for="Birthday" type="date" min="1980-01-01" max="2016-12-31" class="form-control" />
        <span asp-validation-for="Birthday" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Height" class="form-label"></label>
        <input asp-for="Height" type="number" class="form-control" />
        <span asp-validation-for="Height" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Weight" class="form-label"></label>
        <input asp-for="Weight" type="number" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="BirthCity" class="form-label"></label>
        <input asp-for="BirthCity" class="form-control" />
        <span asp-validation-for="BirthCity" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="BirthState" class="form-label"></label>
        <select asp-for="BirthState" class="form-select" asp-items="ViewBag.States"></select>
        <span asp-validation-for="BirthState" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Отмена</a>
</form>

