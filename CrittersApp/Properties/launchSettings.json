{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "wcf": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://*:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Validation__Transport": "Wcf"
      }
    },
    "grpc": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://*:5001",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Validation__Transport": "Grpc"
      }
    }
  }
}
