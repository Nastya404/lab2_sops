<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Клиент: только веб-интерфейс, данных не хранит. Всё через службы на сервере. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Вариант 2.1: WCF-клиент (прокси-класс RosterServiceReference/Reference.cs) -->
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.20" />
  </ItemGroup>

  <!-- Вариант 2.2: gRPC-клиент. Один .proto на клиент и сервер: контракт берётся из проекта службы -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\CrittersGrpcService\Protos\roster.proto" GrpcServices="Client" Link="Protos\roster.proto" />
  </ItemGroup>
</Project>
